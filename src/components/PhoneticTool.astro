---
import type { PhoneticPageDef } from '../data/phonetic-pages';

interface Props { page: PhoneticPageDef }
const { page } = Astro.props;
---

<section class="phonetic-tool rounded-2xl border border-ink/10 bg-white p-4 shadow-card sm:p-6" data-lang={page.langCode} data-sample={page.sample}>
  <div class="flex flex-wrap items-baseline justify-between gap-3"><div><h2 class="font-display text-2xl">Type English sounds</h2><p class="mt-1 text-sm text-ink/65">Example: <span class="font-mono">{page.sample}</span> → <span dir="auto" class="text-lg">{page.output}</span></p></div><span data-status class="text-xs text-sage" role="status" aria-live="polite">Ready</span></div>
  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <label class="text-sm font-semibold">English / phonetic input<textarea data-input class="mt-1 min-h-[200px] w-full resize-y rounded-xl border border-ink/15 bg-cream/60 p-3 text-lg leading-relaxed focus:border-brass focus:outline-none focus:ring-2 focus:ring-brass/50" placeholder={page.sample} spellcheck="false"></textarea></label>
    <label class="text-sm font-semibold">{page.name} Unicode output<textarea data-output class="mt-1 min-h-[200px] w-full resize-y rounded-xl border border-ink/15 bg-cream/60 p-3 text-lg leading-relaxed focus:border-brass focus:outline-none focus:ring-2 focus:ring-brass/50" readonly dir="auto" spellcheck="false"></textarea></label>
  </div>
  <div class="mt-4 flex flex-wrap gap-2"><button type="button" data-sample class="rounded-lg bg-brass px-4 py-2 text-sm font-semibold text-ink">Load sample</button><button type="button" data-copy class="rounded-lg bg-night px-4 py-2 text-sm font-semibold text-paper">Copy output</button><button type="button" data-download class="rounded-lg border border-ink/15 px-4 py-2 text-sm font-semibold">Download .txt</button><button type="button" data-clear class="rounded-lg border border-ink/15 px-4 py-2 text-sm font-semibold">Clear</button></div>
  <p class="mt-3 text-xs leading-relaxed text-ink/60">This is phonetic input, not machine translation. It is designed for common words and sound patterns; review names, long sentences and specialist vocabulary before sending.</p>
</section>

<script>
  import { transliterate } from '../lib/phonetic';
  const init = (root: HTMLElement) => {
    const input = root.querySelector<HTMLTextAreaElement>('[data-input]')!;
    const output = root.querySelector<HTMLTextAreaElement>('[data-output]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const lang = root.dataset.lang || 'hi';
    const sample = root.dataset.sample || '';
    const convert = () => { output.value = transliterate(input.value, lang); status.textContent = input.value ? 'Converted locally.' : 'Ready'; };
    input.addEventListener('input', convert);
    root.querySelector('[data-sample]')!.addEventListener('click', () => { input.value = sample; convert(); });
    root.querySelector('[data-copy]')!.addEventListener('click', async () => { if (!output.value) { status.textContent = 'Nothing to copy yet.'; return; } try { await navigator.clipboard.writeText(output.value); status.textContent = 'Copied.'; } catch { output.select(); status.textContent = 'Output selected.'; } });
    root.querySelector('[data-download]')!.addEventListener('click', () => { if (!output.value) { status.textContent = 'Nothing to download yet.'; return; } const url = URL.createObjectURL(new Blob([output.value], { type: 'text/plain;charset=utf-8' })); const link = document.createElement('a'); link.href = url; link.download = `${lang}-phonetic.txt`; link.click(); URL.revokeObjectURL(url); status.textContent = 'Download started.'; });
    root.querySelector('[data-clear]')!.addEventListener('click', () => { input.value = ''; output.value = ''; status.textContent = 'Cleared.'; });
  };
  document.querySelectorAll<HTMLElement>('.phonetic-tool').forEach(init);
</script>
