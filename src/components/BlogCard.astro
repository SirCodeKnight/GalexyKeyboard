---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const url = `${base}/blog/${post.slug}/`;

const dateOptions: Intl.DateTimeFormatOptions = {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
};
const formattedDate = post.data.pubDate.toLocaleDateString('en-US', dateOptions);
---

<article class="flex flex-col bg-white rounded-2xl border border-ink/10 shadow-sm overflow-hidden hover:shadow-card hover:border-brass/60 transition duration-300 group h-full">
  <a href={url} class="flex flex-col flex-grow p-5 sm:p-6">
    <div class="flex items-center justify-between text-xs text-ink/50 mb-3">
      <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
      {post.data.featured && <span class="bg-brass/20 text-brassdark px-2 py-0.5 rounded-full font-medium">Featured</span>}
    </div>

    <h3 class="font-display text-xl sm:text-2xl text-ink leading-tight mb-3 group-hover:text-brassdark transition-colors">
      {post.data.title}
    </h3>

    <p class="text-ink/75 text-sm sm:text-base leading-relaxed mb-6 flex-grow">
      {post.data.description}
    </p>

    <div class="flex flex-wrap gap-2 mt-auto">
      {post.data.tags.slice(0, 3).map((tag) => (
        <span class="text-[10px] font-semibold uppercase tracking-wider bg-cream text-ink/60 px-2.5 py-1 rounded-md border border-ink/5">
          {tag}
        </span>
      ))}
    </div>
  </a>
</article>
