---
import Base from '../layouts/Base.astro';
import UnicodeTool from './UnicodeTool.astro';
import type { UnicodeToolDef } from '../data/unicode-tools';

interface Props { tool: UnicodeToolDef; options: readonly UnicodeToolDef[] }
const { tool, options } = Astro.props;
const site = (Astro.site?.href ?? 'https://wowgalexy.in').replace(/\/+$/, '');
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const pageUrl = `${site}${base}/${tool.slug}/`;
const faqs = [
  { q: `What does ${tool.name} do?`, a: tool.description },
  { q: 'Is the text private?', a: 'Yes. These are static browser tools. Pasted text is processed in the current tab and is not submitted to GalexyKeyboard.' },
  { q: 'Can I copy the processed text?', a: 'Yes. Use Copy result after processing.' },
  { q: 'Can I download the result?', a: 'Yes. Download .txt saves a local UTF-8 file.' },
  { q: 'Does it support emoji and mixed scripts?', a: 'Yes. JavaScript code-point and grapheme handling preserves mixed Unicode text.' },
  { q: 'What is NFC normalization?', a: 'NFC combines canonically equivalent sequences where Unicode defines a composed form, which can help text compare consistently.' },
  { q: 'What are invisible characters?', a: 'They include zero-width spaces, joiners, non-joiners, BOMs and bidirectional control marks that are not normally visible but can affect text behavior.' },
  { q: 'What is an SMS segment?', a: 'A rough count based on GSM-7-sized text or the shorter Unicode SMS segment size. Actual carrier rules can vary.' },
  { q: 'Does the RTL fixer translate text?', a: 'No. It cleans Unicode direction controls and normalizes the text; it does not translate the words.' },
  { q: 'Can I use the inspector for code?', a: 'Yes. It exposes code points, UTF-8 bytes and normalization forms useful for debugging source files and APIs.' },
  { q: 'Does the tool modify my original text automatically?', a: 'No. The original remains in the input box until you choose a cleanup or process action.' },
  { q: 'How do I report an edge case?', a: 'Send a small reproducible sample and the expected result through the contact page.' },
];
const jsonld = [{ '@context': 'https://schema.org', '@type': 'WebApplication', name: tool.name, url: pageUrl, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any (web browser)', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description: tool.description }, { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) }];
---

<Base title={tool.title} description={tool.description} jsonld={jsonld} keywords={`${tool.name}, Unicode tools, RTL text fixer, invisible character detector`}>
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 py-8"><nav class="text-sm text-ink/60" aria-label="Breadcrumb"><a href={`${base}/`} class="hover:text-brassdark">Home</a><span aria-hidden="true"> / </span><a href={`${base}/unicode-tools/`} class="hover:text-brassdark">Unicode tools</a><span aria-hidden="true"> / </span><span class="text-ink">{tool.name}</span></nav><header class="mt-6 max-w-4xl"><p class="text-sm font-semibold uppercase tracking-widest text-brassdark">Unicode developer utility</p><h1 class="mt-2 font-display text-4xl tracking-tight sm:text-5xl">{tool.name}</h1><p class="mt-4 text-lg leading-relaxed text-ink/75">{tool.description}</p></header>{tool.kind === 'hub' ? <section class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{options.filter((option) => option.kind !== 'hub').map((option) => <a href={`${base}/${option.slug}/`} class="rounded-2xl border border-ink/10 bg-white p-5 shadow-sm transition hover:border-brass/60 hover:shadow-card"><h2 class="font-display text-2xl">{option.name}</h2><p class="mt-2 text-sm leading-relaxed text-ink/70">{option.description}</p><span class="mt-4 inline-block text-sm font-semibold text-brassdark">Open tool →</span></a>)}</section> : <div class="mt-8 grid gap-8 lg:grid-cols-8"><main class="space-y-8 lg:col-span-5"><UnicodeTool tool={tool} /><section class="rounded-2xl border border-brass/25 bg-cream/70 p-5 sm:p-6"><h2 class="font-display text-2xl">{tool.name}: direct answer</h2><p class="mt-3 leading-relaxed text-ink/85">{tool.description} Enter text, process it, inspect the locally generated result and copy or download it when you are satisfied.</p><div class="mt-5 overflow-x-auto rounded-xl border border-ink/10 bg-white"><table class="w-full min-w-[560px] text-sm"><thead class="bg-cream/80 text-left"><tr class="border-b border-ink/10"><th class="px-4 py-3">Capability</th><th class="px-4 py-3">Behavior</th></tr></thead><tbody class="divide-y divide-ink/5"><tr><th class="px-4 py-3 text-left font-medium">Input</th><td class="px-4 py-3">Pasted Unicode text</td></tr><tr><th class="px-4 py-3 text-left font-medium">Processing</th><td class="px-4 py-3">Local browser JavaScript</td></tr><tr><th class="px-4 py-3 text-left font-medium">Output</th><td class="px-4 py-3">Inspectable, cleaned or counted Unicode text</td></tr><tr><th class="px-4 py-3 text-left font-medium">Privacy</th><td class="px-4 py-3">No server submission</td></tr></tbody></table></div></section><section><h2 class="font-display text-2xl">Frequently asked questions</h2><div class="mt-4 divide-y divide-ink/10 border-y border-ink/10">{faqs.map((faq) => <details class="group py-4"><summary class="flex cursor-pointer list-none justify-between gap-4 font-medium"><h3>{faq.q}</h3><span class="text-brassdark group-open:rotate-45" aria-hidden="true">+</span></summary><p class="mt-2 leading-relaxed text-ink/80">{faq.a}</p></details>)}</div></section></main><aside class="space-y-6 lg:col-span-3 lg:sticky lg:top-20 lg:self-start"><div class="rounded-2xl border border-ink/10 bg-white p-5 shadow-sm"><h2 class="font-display text-xl">More Unicode tools</h2><ul class="mt-3 space-y-2">{options.filter((option) => option.slug !== tool.slug && option.kind !== 'hub').map((option) => <li><a href={`${base}/${option.slug}/`} class="block rounded-lg border border-ink/10 px-3 py-2 text-sm hover:border-brass/60 hover:bg-cream">{option.name}</a></li>)}</ul></div><div class="rounded-2xl border border-ink/10 bg-cream/70 p-5"><h2 class="font-display text-xl">Need a keyboard?</h2><p class="mt-2 text-sm leading-relaxed text-ink/75"><a href={`${base}/#keyboards`} class="text-brassdark underline">Open the multilingual keyboards</a> to create native text before inspecting or cleaning it.</p></div></aside></div>}</div>
</Base>
