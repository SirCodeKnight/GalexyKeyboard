---
import type { ConverterDef } from '../data/converters';

interface Props {
  converter: ConverterDef;
  options?: readonly ConverterDef[];
}

const { converter, options = [] } = Astro.props;
const payload = JSON.stringify({
  mappingKey: converter.mappingKey,
  direction: converter.direction === 'unicode-to-legacy' ? 'to-legacy' : 'to-unicode',
  sampleInput: converter.sampleInput,
  sampleOutput: converter.sampleOutput,
  options: options.map((option) => ({ slug: option.slug, name: option.name, mappingKey: option.mappingKey })),
});
---

<section class="converter-tool rounded-2xl border border-ink/10 bg-white p-4 shadow-card sm:p-6" data-converter={payload}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h2 class="font-display text-2xl">Try the converter</h2>
      <p class="mt-1 text-sm text-ink/65">Runs entirely in your browser. Your pasted text is not uploaded.</p>
    </div>
    <span data-detection class="rounded-full border border-sage/30 bg-sage/10 px-3 py-1 text-xs font-semibold text-sage">Ready</span>
  </div>

  {options.length > 0 && (
    <label class="mt-4 block text-sm font-semibold">Font family
      <select data-font class="mt-1 block w-full rounded-lg border border-ink/15 bg-cream/60 px-3 py-2 font-normal focus:border-brass focus:outline-none focus:ring-2 focus:ring-brass/50">
        {options.filter((option) => option.mappingKey !== 'generic').map((option) => <option value={option.slug}>{option.name}</option>)}
      </select>
    </label>
  )}

  <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Conversion direction">
    <button type="button" data-direction="to-unicode" class="direction-button rounded-lg bg-night px-3 py-2 text-sm font-semibold text-paper" aria-pressed="true">Legacy → Unicode</button>
    <button type="button" data-direction="to-legacy" class="direction-button rounded-lg border border-ink/15 px-3 py-2 text-sm font-semibold hover:border-brass" aria-pressed="false">Unicode → Legacy</button>
    <button type="button" data-swap class="rounded-lg border border-ink/15 px-3 py-2 text-sm font-semibold hover:border-brass">⇄ Swap direction</button>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <label class="block text-sm font-semibold">Input
      <textarea data-input class="mt-1 min-h-[220px] w-full resize-y rounded-xl border border-ink/15 bg-cream/60 p-3 text-base leading-relaxed focus:border-brass focus:outline-none focus:ring-2 focus:ring-brass/50" spellcheck="false" placeholder={converter.sampleInput}></textarea>
    </label>
    <label class="block text-sm font-semibold">Unicode / legacy output
      <textarea data-output class="mt-1 min-h-[220px] w-full resize-y rounded-xl border border-ink/15 bg-cream/60 p-3 text-base leading-relaxed focus:border-brass focus:outline-none focus:ring-2 focus:ring-brass/50" readonly spellcheck="false" placeholder={converter.sampleOutput}></textarea>
    </label>
  </div>

  <div class="mt-4 flex flex-wrap gap-2">
    <button type="button" data-sample class="rounded-lg bg-brass px-4 py-2 text-sm font-semibold text-ink hover:bg-brass/90">Load sample</button>
    <button type="button" data-convert class="rounded-lg bg-night px-4 py-2 text-sm font-semibold text-paper">Convert</button>
    <button type="button" data-copy class="rounded-lg border border-ink/15 px-4 py-2 text-sm font-semibold hover:border-brass">Copy output</button>
    <button type="button" data-download class="rounded-lg border border-ink/15 px-4 py-2 text-sm font-semibold hover:border-brass">Download .txt</button>
    <button type="button" data-clear class="rounded-lg border border-ink/15 px-4 py-2 text-sm font-semibold hover:border-brass">Clear</button>
    <label class="rounded-lg border border-ink/15 px-4 py-2 text-sm font-semibold hover:border-brass">Open .txt
      <input type="file" data-file class="sr-only" accept=".txt,text/plain" />
    </label>
  </div>
  <p data-status class="mt-3 text-sm text-sage" role="status" aria-live="polite">Ready to convert.</p>
</section>

<script>
  import { convertText } from '../lib/legacy-converter';

  interface Payload { mappingKey: string; direction: 'to-unicode' | 'to-legacy'; sampleInput: string; sampleOutput: string; options: { slug: string; name: string; mappingKey: string }[] }

  function init(root: HTMLElement) {
    const payload = JSON.parse(root.dataset.converter || '{}') as Payload;
    const input = root.querySelector<HTMLTextAreaElement>('[data-input]')!;
    const output = root.querySelector<HTMLTextAreaElement>('[data-output]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const detection = root.querySelector<HTMLElement>('[data-detection]')!;
    const font = root.querySelector<HTMLSelectElement>('[data-font]');
    let mappingKey = payload.mappingKey;
    let direction = payload.direction;

    const announce = (message: string) => { status.textContent = message; };
    const updateButtonState = () => root.querySelectorAll<HTMLButtonElement>('[data-direction]').forEach((button) => {
      const active = button.dataset.direction === direction;
      button.setAttribute('aria-pressed', String(active));
      button.classList.toggle('bg-night', active);
      button.classList.toggle('text-paper', active);
      button.classList.toggle('border', !active);
    });
    const detect = (text: string) => {
      const checks: Array<[RegExp, string]> = [[/Hkkjr|ueLrs|fdrkc/i, 'Likely Kruti Dev / DevLys'], [/g\]kfn/i, 'Likely Preeti'], [/Avwg|evsjv/i, 'Likely Bijoy / Geetanjali'], [/Vie65t/i, 'Likely VNI / TCVN3']];
      const match = checks.find(([pattern]) => pattern.test(text));
      detection.textContent = match ? match[1] : 'Encoding not auto-detected';
    };
    const convert = () => {
      output.value = convertText(input.value, mappingKey, direction);
      detect(input.value);
      announce(input.value ? `Converted ${[...input.value].length} input characters locally.` : 'Paste text or load the sample first.');
    };

    root.querySelectorAll<HTMLButtonElement>('[data-direction]').forEach((button) => button.addEventListener('click', () => {
      direction = button.dataset.direction as 'to-unicode' | 'to-legacy';
      updateButtonState();
      convert();
    }));
    root.querySelector('[data-swap]')!.addEventListener('click', () => {
      direction = direction === 'to-unicode' ? 'to-legacy' : 'to-unicode';
      updateButtonState();
      const oldInput = input.value;
      input.value = output.value || oldInput;
      convert();
    });
    root.querySelector('[data-convert]')!.addEventListener('click', convert);
    input.addEventListener('input', convert);
    root.querySelector('[data-sample]')!.addEventListener('click', () => {
      input.value = payload.sampleInput;
      convert();
    });
    root.querySelector('[data-copy]')!.addEventListener('click', async () => {
      if (!output.value) { announce('Nothing to copy yet.'); return; }
      try { await navigator.clipboard.writeText(output.value); announce('Output copied.'); }
      catch { output.select(); announce('Output selected; use your device Copy command.'); }
    });
    root.querySelector('[data-download]')!.addEventListener('click', () => {
      if (!output.value) { announce('Nothing to download yet.'); return; }
      const url = URL.createObjectURL(new Blob([output.value], { type: 'text/plain;charset=utf-8' }));
      const link = document.createElement('a'); link.href = url; link.download = `${mappingKey}-${direction}.txt`; link.click(); URL.revokeObjectURL(url); announce('Download started.');
    });
    root.querySelector('[data-clear]')!.addEventListener('click', () => { input.value = ''; output.value = ''; detection.textContent = 'Ready'; announce('Cleared.'); });
    font?.addEventListener('change', () => {
      const selected = payload.options.find((option) => option.slug === font.value);
      mappingKey = selected?.mappingKey ?? mappingKey;
      announce(`${selected?.name ?? 'Font family'} selected.`);
      convert();
    });
    root.querySelector<HTMLInputElement>('[data-file]')?.addEventListener('change', (event) => {
      const file = (event.target as HTMLInputElement).files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.addEventListener('load', () => { input.value = String(reader.result ?? ''); convert(); announce(`${file.name} loaded locally.`); });
      reader.readAsText(file);
    });
    updateButtonState();
    if (payload.sampleInput && payload.sampleInput !== 'Paste legacy-font text here') { input.value = payload.sampleInput; convert(); }
  }

  document.querySelectorAll<HTMLElement>('.converter-tool').forEach(init);
</script>
