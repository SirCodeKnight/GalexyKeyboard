---
import Base from '../layouts/Base.astro';
import TypingTestTool from './TypingTestTool.astro';
import type { TypingTestDef } from '../data/typing-tests';

interface Props { test: TypingTestDef; options: readonly TypingTestDef[] }
const { test, options } = Astro.props;
const site = (Astro.site?.href ?? 'https://wowgalexy.in').replace(/\/+$/, '');
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const pageUrl = `${site}${base}/${test.slug}/`;
const faqs = [
  { q: `How is ${test.name} WPM calculated?`, a: 'Gross WPM uses typed characters divided by five and the elapsed minutes. Net WPM is based on correct characters, so mistakes reduce the score.' },
  { q: 'What does accuracy mean?', a: 'Accuracy is the percentage of typed characters that match the target passage at the same position.' },
  { q: 'Does the timer start immediately?', a: 'No. It starts with your first typed character, giving you time to read the passage and prepare.' },
  { q: 'Can I choose one, two, five, ten or fifteen minutes?', a: 'Yes. The duration selector includes 1, 2, 5, 10 and 15 minute sessions.' },
  { q: 'What is Exam mode?', a: 'Exam mode disables Backspace so the result reflects a stricter timed typing exercise.' },
  { q: 'Can I print a certificate?', a: 'Yes. Print certificate opens a local print-friendly result page with the current WPM, accuracy and error count.' },
  { q: 'Is my typing text uploaded?', a: 'No. The passage and your typed text stay in the current browser tab.' },
  { q: 'Can I use this on a phone?', a: 'Yes. The editor is responsive, although a physical keyboard is usually more comfortable for speed practice.' },
  { q: 'Are the passages official government exam passages?', a: 'No. They are short practice passages. Use the timing and metrics for practice, not as an official exam result.' },
  { q: 'Can I change the passage?', a: 'Yes. Choose another passage from the selector and the test resets.' },
  { q: 'What is a good net WPM?', a: 'A useful target depends on the script, layout and exam. Track your own net WPM and accuracy over repeated sessions.' },
  { q: 'Where can I practise the matching layout?', a: `Use the ${test.name} keyboard page or the phonetic typing hub from the related links.` },
];
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: test.title, url: pageUrl, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any (web browser)', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description: test.description },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) },
];
---

<Base title={test.title} description={test.description} jsonld={jsonld} lang={test.langCode} keywords={`${test.name} typing test, ${test.name} WPM, typing speed test, typing accuracy`}>
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 py-8"><nav class="text-sm text-ink/60" aria-label="Breadcrumb"><a href={`${base}/`} class="hover:text-brassdark">Home</a><span aria-hidden="true"> / </span><a href={`${base}/typing-test/`} class="hover:text-brassdark">Typing tests</a><span aria-hidden="true"> / </span><span class="text-ink">{test.name}</span></nav><header class="mt-6 max-w-4xl"><p class="text-sm font-semibold uppercase tracking-widest text-brassdark">Practice mode · WPM · accuracy</p><h1 class="mt-2 font-display text-4xl tracking-tight sm:text-5xl">{test.name} typing test</h1><p class="mt-4 text-lg leading-relaxed text-ink/75">{test.description}</p></header><div class="mt-8 grid gap-8 lg:grid-cols-8"><main class="space-y-8 lg:col-span-5"><TypingTestTool test={test} /><section class="rounded-2xl border border-brass/25 bg-cream/70 p-5 sm:p-6"><h2 class="font-display text-2xl">{test.name} typing test: direct answer</h2><p class="mt-3 leading-relaxed text-ink/85">Choose a duration, read the practice passage, and type it into the editor. The page reports gross WPM, net WPM, accuracy and errors in real time. Because the engine is local, your practice text is not sent to a server.</p><div class="mt-5 overflow-x-auto rounded-xl border border-ink/10 bg-white"><table class="w-full min-w-[560px] text-sm"><thead class="bg-cream/80 text-left"><tr class="border-b border-ink/10"><th class="px-4 py-3">Metric</th><th class="px-4 py-3">Meaning</th></tr></thead><tbody class="divide-y divide-ink/5"><tr><th class="px-4 py-3 text-left font-medium">Gross WPM</th><td class="px-4 py-3">Typed characters ÷ 5 ÷ elapsed minutes</td></tr><tr><th class="px-4 py-3 text-left font-medium">Net WPM</th><td class="px-4 py-3">Correct characters ÷ 5 ÷ elapsed minutes</td></tr><tr><th class="px-4 py-3 text-left font-medium">Accuracy</th><td class="px-4 py-3">Correct characters as a percentage of typed characters</td></tr><tr><th class="px-4 py-3 text-left font-medium">Errors</th><td class="px-4 py-3">Mismatched or extra characters</td></tr></tbody></table></div></section><section><h2 class="font-display text-2xl">Frequently asked questions</h2><div class="mt-4 divide-y divide-ink/10 border-y border-ink/10">{faqs.map((faq) => <details class="group py-4"><summary class="flex cursor-pointer list-none justify-between gap-4 font-medium"><h3>{faq.q}</h3><span class="text-brassdark group-open:rotate-45" aria-hidden="true">+</span></summary><p class="mt-2 leading-relaxed text-ink/80">{faq.a}</p></details>)}</div></section></main><aside class="space-y-6 lg:col-span-3 lg:sticky lg:top-20 lg:self-start"><div class="rounded-2xl border border-ink/10 bg-white p-5 shadow-sm"><h2 class="font-display text-xl">More typing tests</h2><ul class="mt-3 space-y-2">{options.filter((option) => option.slug !== test.slug).slice(0, 10).map((option) => <li><a href={`${base}/${option.slug}/`} class="block rounded-lg border border-ink/10 px-3 py-2 text-sm hover:border-brass/60 hover:bg-cream">{option.name} typing test</a></li>)}</ul></div><div class="rounded-2xl border border-ink/10 bg-cream/70 p-5"><h2 class="font-display text-xl">Keep practising</h2><p class="mt-2 text-sm leading-relaxed text-ink/75"><a href={`${base}/phonetic-typing/`} class="text-brassdark underline">Phonetic typing</a> helps you draft sounds, while the native keyboard pages build exact script-layout muscle memory.</p></div></aside></div></div>
</Base>
