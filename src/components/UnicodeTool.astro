---
import type { UnicodeToolDef } from '../data/unicode-tools';

interface Props { tool: UnicodeToolDef }
const { tool } = Astro.props;
---

<section class="unicode-tool rounded-2xl border border-ink/10 bg-white p-4 shadow-card sm:p-6" data-kind={tool.kind}>
  <div class="flex flex-wrap items-baseline justify-between gap-3"><div><h2 class="font-display text-2xl">{tool.name}</h2><p class="mt-1 text-sm text-ink/65">Runs locally in this browser.</p></div><span data-status class="text-xs text-sage" role="status" aria-live="polite">Ready</span></div>
  <label class="mt-4 block text-sm font-semibold">Input text<textarea data-input class="mt-1 min-h-[220px] w-full resize-y rounded-xl border border-ink/15 bg-cream/60 p-3 text-lg leading-relaxed focus:border-brass focus:outline-none focus:ring-2 focus:ring-brass/50" spellcheck="false" dir={tool.direction ?? 'auto'}></textarea></label>
  {tool.kind === 'rtl' && <p class="mt-2 text-xs text-ink/60">The cleanup keeps right-to-left direction, normalizes Unicode, removes stray bidi controls and converts common Arabic presentation-form characters back to ordinary letters where possible.</p>}
  <div data-results class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></div>
  <div class="mt-4 flex flex-wrap gap-2"><button type="button" data-process class="rounded-lg bg-night px-4 py-2 text-sm font-semibold text-paper">Process</button><button type="button" data-copy class="rounded-lg border border-ink/15 px-4 py-2 text-sm font-semibold">Copy result</button><button type="button" data-download class="rounded-lg border border-ink/15 px-4 py-2 text-sm font-semibold">Download .txt</button><button type="button" data-clear class="rounded-lg border border-ink/15 px-4 py-2 text-sm font-semibold">Clear</button></div>
  {tool.kind === 'invisible' && <button type="button" data-strip class="mt-3 rounded-lg bg-brass px-4 py-2 text-sm font-semibold text-ink">Remove detected invisible characters</button>}
  <textarea data-output class="sr-only" aria-hidden="true" readonly></textarea>
</section>

<script>
  const invisibleNames: Record<number, string> = { 0x200b: 'ZERO WIDTH SPACE', 0x200c: 'ZERO WIDTH NON-JOINER', 0x200d: 'ZERO WIDTH JOINER', 0x2060: 'WORD JOINER', 0x200e: 'LEFT-TO-RIGHT MARK', 0x200f: 'RIGHT-TO-LEFT MARK', 0x202a: 'LEFT-TO-RIGHT EMBEDDING', 0x202b: 'RIGHT-TO-LEFT EMBEDDING', 0x202c: 'POP DIRECTIONAL FORMATTING', 0x202d: 'LEFT-TO-RIGHT OVERRIDE', 0x202e: 'RIGHT-TO-LEFT OVERRIDE', 0xfeff: 'ZERO WIDTH NO-BREAK SPACE / BOM' };
  const formatBytes = (bytes: number) => `${bytes} byte${bytes === 1 ? '' : 's'}`;
  const init = (root: HTMLElement) => {
    const kind = root.dataset.kind || 'counter';
    const input = root.querySelector<HTMLTextAreaElement>('[data-input]')!;
    const output = root.querySelector<HTMLTextAreaElement>('[data-output]')!;
    const results = root.querySelector<HTMLElement>('[data-results]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const process = () => {
      const text = input.value;
      const bytes = new TextEncoder().encode(text).length;
      const graphemes = typeof Intl.Segmenter === 'function' ? [...new Intl.Segmenter(undefined, { granularity: 'grapheme' }).segment(text)].length : [...text].length;
      const words = text.trim() ? text.trim().split(/\s+/u).length : 0;
      const invisible = [...text].filter((character) => invisibleNames[character.codePointAt(0)!]);
      let result = text.normalize('NFC');
      if (kind === 'rtl') result = result.replace(/[\u202a-\u202e\u2066-\u2069]/g, '').normalize('NFC');
      if (kind === 'invisible') result = text;
      output.value = result;
      const cards: Array<[string, string]> = [];
      if (kind === 'inspector') {
        cards.push(['Code points', [...text].map((character) => `U+${character.codePointAt(0)!.toString(16).toUpperCase().padStart(4, '0')}`).join(' ') || '—']);
        cards.push(['UTF-8', [...new TextEncoder().encode(text)].map((byte) => byte.toString(16).toUpperCase().padStart(2, '0')).join(' ') || '—']);
        cards.push(['NFC', text.normalize('NFC') || '—'], ['NFD', text.normalize('NFD') || '—'], ['NFKC', text.normalize('NFKC') || '—'], ['NFKD', text.normalize('NFKD') || '—']);
      } else if (kind === 'invisible') {
        cards.push(['Detected', invisible.length ? invisible.map((character) => `U+${character.codePointAt(0)!.toString(16).toUpperCase()} ${invisibleNames[character.codePointAt(0)!]}`).join(', ') : 'None found']);
        cards.push(['Graphemes', String(graphemes)], ['UTF-8 size', formatBytes(bytes)]);
      } else {
        cards.push(['Words', String(words)], ['Characters', String([...text].length)], ['Graphemes', String(graphemes)], ['UTF-8 bytes', String(bytes)], ['SMS segments', text.length ? `${Math.ceil(text.length / (/[\u0080-\uFFFF]/u.test(text) ? 70 : 160))}` : '0']);
      }
      results.innerHTML = cards.map(([label, value]) => `<div class="rounded-xl border border-ink/10 bg-cream/70 p-3"><span class="block text-xs uppercase tracking-wide text-ink/55">${label}</span><strong class="mt-1 block break-words text-sm">${value.replace(/</g, '&lt;')}</strong></div>`).join('');
      status.textContent = text ? 'Processed locally.' : 'Ready';
    };
    input.addEventListener('input', process);
    root.querySelector('[data-process]')!.addEventListener('click', process);
    root.querySelector('[data-strip]')?.addEventListener('click', () => { input.value = [...input.value].filter((character) => !invisibleNames[character.codePointAt(0)!]).join(''); process(); status.textContent = 'Invisible characters removed locally.'; });
    root.querySelector('[data-copy]')!.addEventListener('click', async () => { const text = output.value || input.value; if (!text) { status.textContent = 'Nothing to copy yet.'; return; } try { await navigator.clipboard.writeText(text); status.textContent = 'Copied.'; } catch { input.select(); status.textContent = 'Text selected.'; } });
    root.querySelector('[data-download]')!.addEventListener('click', () => { const text = output.value || input.value; if (!text) { status.textContent = 'Nothing to download yet.'; return; } const url = URL.createObjectURL(new Blob([text], { type: 'text/plain;charset=utf-8' })); const link = document.createElement('a'); link.href = url; link.download = 'galexy-unicode-result.txt'; link.click(); URL.revokeObjectURL(url); status.textContent = 'Download started.'; });
    root.querySelector('[data-clear]')!.addEventListener('click', () => { input.value = ''; output.value = ''; results.replaceChildren(); status.textContent = 'Cleared.'; });
  };
  document.querySelectorAll<HTMLElement>('.unicode-tool').forEach(init);
</script>
