---
import Base from '../layouts/Base.astro';
import KeyboardTool from './KeyboardTool.astro';
import { KEYBOARDS } from '../data/keyboards';
import type { KeyboardDef } from '../data/keyboards';

interface Props { kb: KeyboardDef }
const { kb } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const site = (Astro.site?.href ?? '').replace(/\/+$/, '');
const pageUrl = `${site}${base}/${kb.slug}/`;

const idx = KEYBOARDS.findIndex((k) => k.slug === kb.slug);
const others = KEYBOARDS.filter((k) => k.slug !== kb.slug);
const related = [...others.slice(idx), ...others.slice(0, idx)].slice(0, 6);

const customMemes = ['hindi-keyboard', 'spanish-keyboard'];
const scriptRange = {
  'hindi-keyboard': 'U+0900–U+097F Devanagari',
  'arabic-keyboard': 'U+0600–U+06FF Arabic',
  'bengali-keyboard': 'U+0980–U+09FF Bengali',
  'assamese-keyboard': 'U+0980–U+09FF Assamese',
  'urdu-keyboard': 'U+0600–U+06FF Arabic-derived',
  'russian-keyboard': 'U+0400–U+04FF Cyrillic',
  'ukrainian-keyboard': 'U+0400–U+04FF Cyrillic',
  'greek-keyboard': 'U+0370–U+03FF Greek and Coptic',
  'hebrew-keyboard': 'U+0590–U+05FF Hebrew',
  'thai-keyboard': 'U+0E00–U+0E7F Thai',
  'japanese-keyboard': 'U+3040–U+309F Hiragana',
  'korean-keyboard': 'U+1100–U+11FF Jamo and U+AC00–U+D7AF Hangul',
  'spanish-keyboard': 'U+0000–U+007F Latin with Spanish extensions',
  'tamil-keyboard': 'U+0B80–U+0BFF Tamil',
  'farsi-keyboard': 'U+0600–U+06FF Arabic-derived',
} as Record<string, string>;
const layoutStandard = {
  'hindi-keyboard': 'InScript',
  'arabic-keyboard': 'Arabic 101',
  'bengali-keyboard': 'InScript',
  'assamese-keyboard': 'InScript-inspired Assamese layout',
  'urdu-keyboard': 'Urdu phonetic / national layout',
  'russian-keyboard': 'ЙЦУКЕН (JCUKEN)',
  'ukrainian-keyboard': 'Ukrainian national layout',
  'greek-keyboard': 'Greek national layout',
  'hebrew-keyboard': 'Israeli layout',
  'thai-keyboard': 'Kedmanee',
  'japanese-keyboard': 'Gojūon hiragana order',
  'korean-keyboard': '2-set Dubeolsik',
  'spanish-keyboard': 'Spanish QWERTY with special characters',
  'tamil-keyboard': 'Tamil script reference layout',
  'farsi-keyboard': 'Iranian standard layout',
} as Record<string, string>;
const physicalRows = [
  ['`', '1', '2', '3', '4', '5', '6', '7', '8', '9', '0', '-', '='],
  ['Q', 'W', 'E', 'R', 'T', 'Y', 'U', 'I', 'O', 'P', '[', ']', '\\'],
  ['A', 'S', 'D', 'F', 'G', 'H', 'J', 'K', 'L', ';', "'"],
  ['Z', 'X', 'C', 'V', 'B', 'N', 'M', ',', '.', '/'],
];
const physicalOffset = kb.rows.length >= 4 ? 0 : 1;
const physicalMappings = kb.rows.map((row, rowIndex) => row.map((key, keyIndex) => ({
  physical: physicalRows[physicalOffset + rowIndex]?.[keyIndex] ?? `Key ${keyIndex + 1}`,
  base: key.b,
  shifted: key.s ?? (kb.autoUpper ? key.b.toUpperCase() : key.b),
})));
const directAnswer = `${kb.name} Keyboard Online is a free browser tool for entering Unicode ${kb.name} text without installing a system keyboard. Use the on-screen ${kb.name} layout or the supported physical-keyboard mapping, then copy or download the result. ${kb.dir === 'rtl' ? `The editor uses right-to-left direction for ${kb.name}.` : `The editor uses left-to-right direction for ${kb.name}.`} Your text stays in the browser until you choose an external action.`;

const jsonld = [
  {
    '@context': 'https://schema.org', '@type': 'WebApplication',
    name: `${kb.name} Keyboard Online \u2013 GalexyKeyboard`, url: pageUrl,
    applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any (web browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: kb.description,
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: kb.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org', '@type': 'HowTo',
    name: `How to type in ${kb.name} online`,
    step: [
      { '@type': 'HowToStep', position: 1, name: 'Open the keyboard', text: `Open the free online ${kb.name} keyboard in any browser \u2013 no download or sign-up needed.` },
      { '@type': 'HowToStep', position: 2, name: `Type your ${kb.name} text`, text: 'Click or tap the on-screen keys, or enable physical typing to use your own keyboard remapped to this layout.' },
      { '@type': 'HowToStep', position: 3, name: 'Copy and send', text: 'Press the Copy button and paste your text into WhatsApp, email, Google, social media or any document.' },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'GalexyKeyboard', item: `${site}${base}/` },
      { '@type': 'ListItem', position: 2, name: `${kb.name} keyboard`, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'Organization',
    name: 'GalexyKeyboard', url: `${site}${base}/`,
    contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: 'contact@wowgalexy.in' },
  },
];
---
<Base title={kb.title} description={kb.description} jsonld={jsonld} lang={kb.langCode || 'en'} keywords={kb.keywords}>
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 py-6 grid lg:grid-cols-12 gap-8 items-start">
    <!-- Main Tool & Info Column -->
    <div class="lg:col-span-8 col-span-12 space-y-6">
      <nav class="text-sm text-ink/60" aria-label="Breadcrumb">
        <a href={`${base}/`} class="hover:text-brassdark">All keyboards</a>
        <span aria-hidden="true"> / </span>
        <span class="text-ink">{kb.name} keyboard</span>
      </nav>

      {/* Flag Emblem & Native Welcome Card */}
      <div class="welcome-header-card rounded-2xl bg-gradient-to-r from-brass/15 to-brass/5 border border-brass/25 p-5 flex flex-col sm:flex-row items-center gap-5 shadow-sm relative overflow-hidden">
        <img src={`https://flagcdn.com/w80/${kb.countryCode}.png`} class="w-16 h-11 object-cover rounded-lg shadow-md border border-ink/10 z-10" alt={`${kb.name} flag`} />
        <div class="text-center sm:text-left z-10">
          <h2 class="text-2xl font-extrabold font-display text-ink leading-tight">
            {kb.welcome}
          </h2>
          <p class="text-sm text-ink/75 mt-1">Welcome! Start typing in {kb.name} using our advanced 3D virtual keyboard.</p>
        </div>
        <div class="absolute right-[-20px] bottom-[-20px] text-brass/10 opacity-30 text-8xl font-bold select-none pointer-events-none leading-none">{kb.native}</div>
      </div>

      <header class="max-w-3xl">
        <h1 class="font-display text-3xl sm:text-4xl tracking-tight">
          {kb.name} Keyboard Online <span class="text-brassdark whitespace-nowrap">({kb.native})</span>
        </h1>
        <p class="mt-3 text-lg text-ink/80">{kb.tagline}</p>
        <p class="mt-2 text-sm text-ink/60">A free online {kb.name} keyboard: type {kb.name} in your browser, then copy the text and paste it anywhere. No download, no sign-up.</p>
      </header>

      <div class="mt-8">
        <KeyboardTool kb={kb} />
      </div>

      <section class="mt-8 rounded-2xl border border-brass/25 bg-cream/70 p-5 sm:p-6" aria-labelledby="direct-answer-title">
        <h2 id="direct-answer-title" class="font-display text-2xl">{kb.name} keyboard: direct answer and specifications</h2>
        <p class="mt-3 leading-relaxed text-ink/85">{directAnswer}</p>
        <div class="mt-5 overflow-x-auto rounded-xl border border-ink/10 bg-white">
          <table class="w-full min-w-[620px] text-sm">
            <caption class="sr-only">{kb.name} keyboard specifications</caption>
            <thead class="bg-cream/80 text-left">
              <tr class="border-b border-ink/10">
                <th scope="col" class="px-4 py-3 font-semibold">Specification</th>
                <th scope="col" class="px-4 py-3 font-semibold">Value</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-ink/5">
              <tr><th scope="row" class="px-4 py-3 text-left font-medium">Layout</th><td class="px-4 py-3">{layoutStandard[kb.slug] ?? 'Language-specific Unicode layout'}</td></tr>
              <tr><th scope="row" class="px-4 py-3 text-left font-medium">Text direction</th><td class="px-4 py-3">{kb.dir === 'rtl' ? 'Right to left (RTL)' : 'Left to right (LTR)'}</td></tr>
              <tr><th scope="row" class="px-4 py-3 text-left font-medium">Unicode coverage</th><td class="px-4 py-3">{scriptRange[kb.slug] ?? 'Unicode script characters'}</td></tr>
              <tr><th scope="row" class="px-4 py-3 text-left font-medium">Physical remapping</th><td class="px-4 py-3">{kb.rows.length === 3 || kb.rows.length === 4 ? 'Supported for the main rows on desktop' : 'Use the on-screen layout or the device input method'}</td></tr>
              <tr><th scope="row" class="px-4 py-3 text-left font-medium">Export</th><td class="px-4 py-3">Clipboard copy and UTF-8 plain-text download</td></tr>
            </tbody>
          </table>
        </div>
        {(kb.rows.length === 3 || kb.rows.length === 4) ? (
          <div class="mt-6">
            <h3 class="font-display text-xl">Physical QWERTY-to-{kb.name} mapping</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/75">On desktop, the Physical keyboard option maps these main-row QWERTY positions to the {kb.name} layout. Helper marks and accent rows remain available as on-screen keys.</p>
            <div class="mt-4 space-y-3 overflow-x-auto">
              {physicalMappings.map((row, rowIndex) => (
                <table class="min-w-[620px] w-full text-sm border-separate border-spacing-1">
                  <caption class="sr-only">{kb.name} physical mapping row {rowIndex + 1}</caption>
                  <tbody>
                    <tr>
                      {row.map((mapping) => <th scope="col" class="rounded-md bg-night px-2 py-2 text-center font-semibold text-paper">{mapping.physical}</th>)}
                    </tr>
                    <tr dir={kb.dir}>
                      {row.map((mapping) => <td class="rounded-md border border-ink/10 bg-white px-2 py-2 text-center text-lg" title={`Physical ${mapping.physical}; Shift: ${mapping.shifted}`}>{mapping.base}</td>)}
                    </tr>
                    <tr dir={kb.dir}>
                      {row.map((mapping) => <td class="rounded-md border border-ink/10 bg-cream/70 px-2 py-1 text-center text-xs text-ink/70" title={`Shift + ${mapping.physical}`}>{mapping.shifted}</td>)}
                    </tr>
                  </tbody>
                </table>
              ))}
            </div>
          </div>
        ) : (
          <p class="mt-6 rounded-xl border border-ink/10 bg-white/70 p-4 text-sm leading-relaxed text-ink/75">This {kb.name} layout has more rows than the desktop remapping matrix, so use the on-screen keys or your device&apos;s own input method for full coverage.</p>
        )}
      </section>

      <section class="mt-12 space-y-10">
        <div class="space-y-10">
          <article>
            <h2 class="font-display text-2xl">About the {kb.name} keyboard</h2>
            <p class="mt-3 leading-relaxed text-ink/85">{kb.intro}</p>
          </article>

          <article>
            <h2 class="font-display text-2xl">How to type in {kb.name} online</h2>
            <ol class="mt-4 space-y-3">
              {[
                `Open this free ${kb.name} keyboard \u2013 it works instantly in any browser on desktop or mobile.`,
                'Click or tap the on-screen keys, or enable physical typing to use your own keyboard remapped to this layout.',
                `Press Copy and paste your ${kb.name} text into WhatsApp, email, Google, social media or any document.`,
              ].map((step, i) => (
                <li class="flex gap-3">
                  <span class="flex-none w-7 h-7 rounded-full bg-ink text-paper text-sm grid place-items-center">{i + 1}</span>
                  <p class="leading-relaxed text-ink/85">{step}</p>
                </li>
              ))}
            </ol>
          </article>

          <article>
            <h2 class="font-display text-2xl">Typing tips</h2>
            <ul class="mt-4 space-y-2.5">
              {kb.tips.map((t) => (
                <li class="flex gap-2.5">
                  <span class="flex-none mt-2 w-1.5 h-1.5 rounded-full bg-brass"></span>
                  <p class="leading-relaxed text-ink/85">{t}</p>
                </li>
              ))}
            </ul>
          </article>

          {kb.scriptHistory && (
            <article>
              <h2 class="font-display text-2xl">About the {kb.name} script</h2>
              <p class="mt-3 leading-relaxed text-ink/85">{kb.scriptHistory}</p>
            </article>
          )}

          {kb.layoutDescription && (
            <article>
              <h2 class="font-display text-2xl">Understanding the keyboard layout</h2>
              <p class="mt-3 leading-relaxed text-ink/85">{kb.layoutDescription}</p>
            </article>
          )}

          {kb.commonPhrases && kb.commonPhrases.length > 0 && (
            <article>
              <h2 class="font-display text-2xl">Common {kb.name} phrases</h2>
              <p class="mt-2 text-sm text-ink/60">Type these phrases using the keyboard above, then copy and paste them anywhere.</p>
              <div class="mt-4 overflow-x-auto rounded-xl border border-ink/10">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="bg-cream/80 border-b border-ink/10">
                      <th class="text-left px-4 py-2.5 font-semibold" dir={kb.dir}>{kb.name}</th>
                      <th class="text-left px-4 py-2.5 font-semibold">Pronunciation</th>
                      <th class="text-left px-4 py-2.5 font-semibold">Meaning</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-ink/5">
                    {kb.commonPhrases.map((p) => (
                      <tr class="hover:bg-cream/40 transition-colors">
                        <td class="px-4 py-2.5 font-medium text-base" dir={kb.dir}>{p.phrase}</td>
                        <td class="px-4 py-2.5 text-ink/70 italic">{p.transliteration}</td>
                        <td class="px-4 py-2.5 text-ink/80">{p.meaning}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </article>
          )}

          {kb.useCases && kb.useCases.length > 0 && (
            <article>
              <h2 class="font-display text-2xl">When to use this {kb.name} keyboard</h2>
              <ul class="mt-4 space-y-2.5">
                {kb.useCases.map((uc) => (
                  <li class="flex gap-2.5">
                    <span class="flex-none mt-2 w-1.5 h-1.5 rounded-full bg-brass"></span>
                    <p class="leading-relaxed text-ink/85">{uc}</p>
                  </li>
                ))}
              </ul>
            </article>
          )}

          <article>
            <h2 class="font-display text-2xl">Frequently asked questions</h2>
            <div class="mt-4 divide-y divide-ink/10 border-y border-ink/10">
              {kb.faqs.map((f) => (
                <details class="group py-4">
                  <summary class="cursor-pointer list-none flex items-baseline justify-between gap-4 font-medium">
                    <h3 class="text-base font-medium">{f.q}</h3>
                    <span class="text-brassdark transition group-open:rotate-45" aria-hidden="true">+</span>
                  </summary>
                  <p class="mt-2 leading-relaxed text-ink/80">{f.a}</p>
                </details>
              ))}
            </div>
          </article>
        </div>
      </section>
    </div>

    <!-- Right Sidebar -->
    <div class="lg:col-span-4 col-span-12 space-y-6 sticky top-20">
      <aside class="space-y-6">
        <div class="bg-white p-5 rounded-2xl border border-ink/10 shadow-sm">
          <h2 class="font-display text-xl">More keyboards</h2>
          <ul class="mt-4 space-y-2">
            {related.map((k) => (
              <li>
                <a href={`${base}/${k.slug}/`} class="flex items-center justify-between rounded-xl border border-ink/10 bg-white px-4 py-3 hover:border-brass/60 hover:shadow-card transition duration-200">
                  <span class="flex items-center gap-2">
                    <img src={`https://flagcdn.com/w40/${k.countryCode}.png`} class="w-5 h-3.5 object-cover rounded-[2px] border border-ink/5" alt="" />
                    <span>{k.name} keyboard</span>
                  </span>
                  <span class="text-ink/50 text-sm">{k.native}</span>
                </a>
              </li>
            ))}
          </ul>
          <a href={`${base}/#keyboards`} class="mt-4 inline-block text-sm text-brassdark hover:underline">See all language keyboards</a>
        </div>

        {/* Meme Sticker */}
        <div class="meme-sticker-card p-3 bg-white rounded-2xl border border-ink/10 shadow-sm relative overflow-hidden group hover:shadow-md transition">
          <div class="text-[10px] font-bold text-ink/40 uppercase mb-2">Local Vibe Sticker</div>
          <img src={`${base}/memes/${customMemes.includes(kb.slug) ? kb.slug : 'typing-meme'}.png`} alt={`Funny ${kb.name} meme`} class="w-full h-auto rounded-lg object-contain bg-slate-50 border border-slate-100 group-hover:scale-105 transition-transform duration-300" />
        </div>
      </aside>
    </div>
  </div>
</Base>
