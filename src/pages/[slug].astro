---
import KeyboardPage from '../components/KeyboardPage.astro';
import ConverterPage from '../components/ConverterPage.astro';
import { KEYBOARDS } from '../data/keyboards';
import { CONVERTERS } from '../data/converters';
import PhoneticPage from '../components/PhoneticPage.astro';
import TypingTestPage from '../components/TypingTestPage.astro';
import UnicodeToolPage from '../components/UnicodeToolPage.astro';
import { PHONETIC_PAGES } from '../data/phonetic-pages';
import { TYPING_TESTS } from '../data/typing-tests';
import { UNICODE_TOOLS } from '../data/unicode-tools';
import type { KeyboardDef } from '../data/keyboards';
import type { ConverterDef } from '../data/converters';
import type { PhoneticPageDef } from '../data/phonetic-pages';
import type { TypingTestDef } from '../data/typing-tests';
import type { UnicodeToolDef } from '../data/unicode-tools';

export function getStaticPaths() {
  return [
    ...KEYBOARDS.map((kb) => ({ params: { slug: kb.slug }, props: { kind: 'keyboard' as const, kb } })),
    ...CONVERTERS.map((converter) => ({ params: { slug: converter.slug }, props: { kind: 'converter' as const, converter } })),
    ...PHONETIC_PAGES.map((page) => ({ params: { slug: page.slug }, props: { kind: 'phonetic' as const, page } })),
    ...TYPING_TESTS.map((test) => ({ params: { slug: test.slug }, props: { kind: 'typing' as const, test } })),
    ...UNICODE_TOOLS.map((tool) => ({ params: { slug: tool.slug }, props: { kind: 'unicode' as const, tool } })),
  ];
}

interface Props {
  kind: 'keyboard' | 'converter' | 'phonetic' | 'typing' | 'unicode';
  kb?: KeyboardDef;
  converter?: ConverterDef;
  page?: PhoneticPageDef;
  test?: TypingTestDef;
  tool?: UnicodeToolDef;
}
const { kind, kb, converter, page, test, tool } = Astro.props;
---

{kind === 'keyboard' && kb ? <KeyboardPage kb={kb} /> : kind === 'converter' && converter ? <ConverterPage converter={converter} options={CONVERTERS} /> : kind === 'phonetic' && page ? <PhoneticPage page={page} options={PHONETIC_PAGES} /> : kind === 'typing' && test ? <TypingTestPage test={test} options={TYPING_TESTS} /> : kind === 'unicode' && tool ? <UnicodeToolPage tool={tool} options={UNICODE_TOOLS} /> : null}
