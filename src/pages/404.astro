---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---
<Base title="Page Not Found – GalexyKeyboard" description="The page you are looking for does not exist. Head back to GalexyKeyboard and start typing in any language.">
  <section class="flex flex-col items-center justify-center min-h-[65vh] text-center px-4">
    <div class="relative">
      <!-- Decorative floating keys -->
      <div class="absolute -top-16 -left-12 w-12 h-12 rounded-xl bg-ink/5 border border-ink/10 flex items-center justify-center text-2xl text-ink/20 animate-bounce" style="animation-delay: 0.2s; animation-duration: 3s;">あ</div>
      <div class="absolute -top-8 -right-16 w-10 h-10 rounded-lg bg-ink/5 border border-ink/10 flex items-center justify-center text-xl text-ink/20 animate-bounce" style="animation-delay: 0.8s; animation-duration: 3.5s;">ك</div>
      <div class="absolute -bottom-10 -left-8 w-10 h-10 rounded-lg bg-ink/5 border border-ink/10 flex items-center justify-center text-xl text-ink/20 animate-bounce" style="animation-delay: 1.2s; animation-duration: 4s;">Я</div>
      <div class="absolute -bottom-12 right-0 w-11 h-11 rounded-xl bg-ink/5 border border-ink/10 flex items-center justify-center text-xl text-ink/20 animate-bounce" style="animation-delay: 0.5s; animation-duration: 3.2s;">한</div>

      <h1 class="font-display text-8xl sm:text-9xl tracking-tight text-ink/10 select-none">404</h1>
    </div>

    <p class="mt-4 font-display text-2xl sm:text-3xl text-ink tracking-tight">
      This key doesn't exist on any keyboard.
    </p>
    <p class="mt-3 text-ink/60 max-w-md leading-relaxed">
      The page you're looking for may have been moved or doesn't exist. But your perfect keyboard is just one click away.
    </p>

    <div class="mt-8 flex flex-wrap gap-3 justify-center">
      <a href={`${base}/`} class="rounded-lg bg-brass text-paper px-6 py-3 font-medium hover:bg-brass/90 transition shadow-sm">
        ⬅ Back to all keyboards
      </a>
      <a href={`${base}/about/`} class="rounded-lg border border-ink/15 px-6 py-3 hover:bg-ink/5 transition">
        About GalexyKeyboard
      </a>
    </div>

    <p class="mt-12 text-sm text-ink/40">
      Looking for a specific keyboard? Try
      <a href={`${base}/hindi-keyboard/`} class="text-brassdark hover:underline">Hindi</a>,
      <a href={`${base}/arabic-keyboard/`} class="text-brassdark hover:underline">Arabic</a>,
      <a href={`${base}/japanese-keyboard/`} class="text-brassdark hover:underline">Japanese</a>, or
      <a href={`${base}/korean-keyboard/`} class="text-brassdark hover:underline">Korean</a>.
    </p>
  </section>
</Base>
