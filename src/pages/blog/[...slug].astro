---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { KEYBOARDS } from '../../data/keyboards';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const site = (Astro.site?.href ?? '').replace(/\/+$/, '');
const pageUrl = `${site}${base}/blog/${post.slug}/`;

const dateOptions: Intl.DateTimeFormatOptions = {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
};
const formattedDate = post.data.pubDate.toLocaleDateString('en-US', dateOptions);

// Shuffle and pick 5 related keyboards for the sidebar
const shuffled = [...KEYBOARDS].sort(() => 0.5 - Math.random());
const relatedKeyboards = shuffled.slice(0, 5);

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    author: {
      '@type': 'Organization',
      name: post.data.author,
    },
    datePublished: post.data.pubDate.toISOString(),
    ...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': pageUrl,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'GalexyKeyboard', item: `${site}${base}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site}${base}/blog/` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: pageUrl },
    ],
  },
];
---
<Base title={`${post.data.title} \u2013 GalexyKeyboard Blog`} description={post.data.description} jsonld={jsonld}>
  <div class="max-w-[1536px] mx-auto px-4 sm:px-6 py-6 grid xl:grid-cols-12 gap-8 items-start">

    <!-- Left padding for layout balance -->
    <div class="xl:col-span-2 hidden xl:block"></div>

    <!-- Main Content -->
    <main class="xl:col-span-7 col-span-12 space-y-6">
      <nav class="text-sm text-ink/60 mb-8" aria-label="Breadcrumb">
        <a href={`${base}/`} class="hover:text-brassdark transition-colors">Home</a>
        <span aria-hidden="true"> / </span>
        <a href={`${base}/blog/`} class="hover:text-brassdark transition-colors">Blog</a>
        <span aria-hidden="true"> / </span>
        <span class="text-ink truncate block sm:inline">{post.data.title}</span>
      </nav>

      <article class="bg-white p-6 sm:p-10 rounded-2xl border border-ink/10 shadow-sm">
        <header class="mb-10 pb-10 border-b border-ink/10">
          <div class="flex flex-wrap gap-2 mb-6">
            {post.data.tags.map(tag => (
              <span class="text-xs font-bold uppercase tracking-wider bg-cream text-ink/70 px-3 py-1 rounded-md border border-ink/5">
                {tag}
              </span>
            ))}
          </div>

          <h1 class="font-display text-3xl sm:text-4xl md:text-5xl text-ink leading-tight mb-6">
            {post.data.title}
          </h1>

          <div class="flex items-center gap-4 text-sm text-ink/60">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-full bg-brass/20 grid place-items-center text-brassdark font-bold font-display">
                {post.data.author.charAt(0)}
              </div>
              <span class="font-medium text-ink/80">{post.data.author}</span>
            </div>
            <span aria-hidden="true">&bull;</span>
            <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
          </div>
        </header>

        <div class="prose prose-lg prose-ink max-w-none prose-headings:font-display prose-headings:font-semibold prose-a:text-brassdark hover:prose-a:text-brass transition-colors">
          <Content />
        </div>
      </article>
    </main>

    <!-- Right Sidebar -->
    <div class="xl:col-span-3 col-span-12 space-y-6 sticky top-20">
      <aside class="space-y-6">
        <div class="bg-white p-5 rounded-2xl border border-ink/10 shadow-sm">
          <h2 class="font-display text-xl mb-4">Try our keyboards</h2>
          <ul class="space-y-2">
            {relatedKeyboards.map((k) => (
              <li>
                <a href={`${base}/${k.slug}/`} class="flex items-center justify-between rounded-xl border border-ink/10 bg-white px-4 py-3 hover:border-brass/60 hover:shadow-card transition duration-200">
                  <span class="flex items-center gap-2">
                    <img src={`https://flagcdn.com/w40/${k.countryCode}.png`} class="w-5 h-3.5 object-cover rounded-[2px] border border-ink/5" alt="" />
                    <span>{k.name}</span>
                  </span>
                  <span class="text-ink/50 text-sm">{k.native}</span>
                </a>
              </li>
            ))}
          </ul>
          <a href={`${base}/#keyboards`} class="mt-4 inline-block text-sm text-brassdark hover:underline font-medium">View all languages &rarr;</a>
        </div>
      </aside>
    </div>

  </div>
</Base>
