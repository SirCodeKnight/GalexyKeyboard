{
  "name": "galexykeyboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node -e \"const fs = require('fs'); fs.copyFileSync('.assetsignore', 'dist/.assetsignore'); fs.copyFileSync('dist/sitemap-index.xml', 'dist/sitemap.xml');\"",
    "deploy": "wrangler deploy",
    "preview": "astro preview"
  },
  "dependencies": {
    "@anthro-ai/krutidev-unicode": "^0.1.0",
    "@astrojs/sitemap": "3.1.6",
    "@astrojs/tailwind": "^5.1.2",
    "@lacspace/preeti": "^1.1.0",
    "astro": "^4.16.18",
    "bijoy-unicode-converter": "^0.1.2",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
