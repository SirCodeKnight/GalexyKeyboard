{
  "openapi": "3.0.3",
  "info": {
    "title": "GalexyKeyboard discovery",
    "version": "1.0.0",
    "description": "Read-only public documentation for the GalexyKeyboard static website. The keyboard itself runs in the browser. There is no remote typing, translation, or text-submission API.",
    "contact": {
      "url": "https://wowgalexy.in/contact/"
    }
  },
  "servers": [
    {
      "url": ".",
      "description": "The directory containing this document, including a GitLab Pages project path when present."
    }
  ],
  "paths": {
    "/llms.txt": {
      "get": {
        "operationId": "getSiteSummary",
        "summary": "Read a concise overview of the keyboard website",
        "responses": {
          "200": {
            "description": "Site summary, supported languages, and discovery links.",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/llms-full.txt": {
      "get": {
        "operationId": "getFullSiteGuide",
        "summary": "Read the full site guide and language-page directory",
        "responses": {
          "200": {
            "description": "Usage instructions, capabilities, common questions, and links to published pages.",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/sitemap-index.xml": {
      "get": {
        "operationId": "getSitemapIndex",
        "summary": "Read Astro's sitemap index to discover published routes",
        "responses": {
          "200": {
            "description": "XML sitemap index pointing to the site's generated sitemap files.",
            "content": {
              "application/xml": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/sitemap.xml": {
      "get": {
        "operationId": "getSitemapCompatibilityAlias",
        "summary": "Read the compatibility sitemap alias",
        "responses": {
          "200": {
            "description": "Equivalent sitemap index for crawlers that request /sitemap.xml.",
            "content": {
              "application/xml": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/font-converter/": {
      "get": {
        "operationId": "getFontConverterHub",
        "summary": "Open the legacy font converter hub",
        "responses": { "200": { "description": "Static converter hub page." } }
      }
    },
    "/phonetic-typing/": {
      "get": {
        "operationId": "getPhoneticTypingHub",
        "summary": "Open the phonetic typing hub",
        "responses": { "200": { "description": "Static phonetic typing hub page." } }
      }
    },
    "/typing-test/": {
      "get": {
        "operationId": "getTypingTestHub",
        "summary": "Open the typing test hub",
        "responses": { "200": { "description": "Static typing test hub page." } }
      }
    },
    "/unicode-tools/": {
      "get": {
        "operationId": "getUnicodeToolsHub",
        "summary": "Open the Unicode tools hub",
        "responses": { "200": { "description": "Static Unicode tools hub page." } }
      }
    }
  }
}
